<Application x:Class="EnglishBench.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="VocabularyHighlightBrush" Color="#F9D3E3"/>
    <SolidColorBrush x:Key="SelectedVocabularyBrush" Color="#F6BEC8"/>
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="#E3EFF9"/>
    <SolidColorBrush x:Key="PlayingSegmentBrush" Color="#FFF0B6"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#F6BEC8"/>
    <SolidColorBrush x:Key="BlankBrush" Color="#566B85"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#285B87"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="#FCFCFC"/>
      <Setter Property="BorderBrush" Value="#DDDDDD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF1F8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE8F3"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
