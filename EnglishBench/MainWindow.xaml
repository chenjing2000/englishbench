<Window x:Class="EnglishBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EnglishBench.Models"
        xmlns:icons="clr-namespace:EnglishBench.Infrastructure"
        Title="EnglishBench" Width="1500" Height="920" MinWidth="1050" MinHeight="620" PreviewKeyDown="PlaybackKeyDown"
        Background="#F3F3F3" FontFamily="Segoe UI" FontSize="11pt" Icon="{x:Static icons:UiIcons.AppIcon}">
  <Window.Resources>
    <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="3,0"/>
    </Style>
    <Style x:Key="SettingsSurface" TargetType="Border">
      <Setter Property="Background" Value="#FCFCFD"/><Setter Property="BorderBrush" Value="#E0E5EB"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="8"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#344256" BlurRadius="12" ShadowDepth="2" Opacity="0.16"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsMenuItem" TargetType="MenuItem">
      <Setter Property="FontSize" Value="10pt"/>
      <Setter Property="Foreground" Value="#283747"/><Setter Property="Padding" Value="6,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="ItemSurface" Background="#FCFCFD" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <TextBlock x:Name="Arrow" Grid.Column="1" Margin="8,0,0,0" Text="›" Visibility="Collapsed" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=ItemSurface}" HorizontalOffset="2" VerticalOffset="-8" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Style="{StaticResource SettingsSurface}"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EDF3F9"/></Trigger>
              <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EDF3F9"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#87C0CA"/></Trigger>
              <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent"><Image x:Name="Symbol" Source="{x:Static icons:UiIcons.Plus}" Width="14" Height="14"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Symbol" Property="Source" Value="{x:Static icons:UiIcons.Minus}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="10,12,10,8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftColumn" Width="310" MinWidth="200"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition x:Name="CenterColumn" Width="*" MinWidth="410"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition x:Name="RightColumn" Width="390" MinWidth="280"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0" Margin="0,0,7,0">
      <Button DockPanel.Dock="Top" Content="选择图书馆" Click="LibraryClicked" Margin="0,0,0,12"/>
      <DockPanel DockPanel.Dock="Bottom" Height="48" Margin="0,8,0,0">
        <Button x:Name="SettingsButton" DockPanel.Dock="Left" Width="26" Height="26" VerticalAlignment="Center" Padding="0" Margin="0,0,10,0" ToolTip="设置" Click="SettingsClicked">
          <Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="#2C78B9"/></ControlTemplate></Button.Template>
          <Button.ContextMenu>
            <ContextMenu Placement="Top" HorizontalOffset="25" VerticalOffset="4" FontSize="10pt" Background="Transparent" PreviewKeyDown="PlaybackKeyDown">
              <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource SettingsMenuItem}"/></ContextMenu.Resources>
              <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Style="{StaticResource SettingsSurface}"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></ContextMenu.Template>
              <MenuItem Header="字号">
                <MenuItem x:Name="Font11Option" Header="11" Tag="11" IsCheckable="True" Click="FontClicked"/>
                <MenuItem x:Name="Font12Option" Header="12" Tag="12" IsCheckable="True" Click="FontClicked"/>
                <MenuItem x:Name="Font13Option" Header="13" Tag="13" IsCheckable="True" Click="FontClicked"/>
              </MenuItem>
              <MenuItem Header="读音">
                <MenuItem x:Name="AccentUkOption" Header="英音" Tag="uk" IsCheckable="True" Click="AccentClicked"/>
                <MenuItem x:Name="AccentUsOption" Header="美音" Tag="us" IsCheckable="True" Click="AccentClicked"/>
              </MenuItem>
              <MenuItem Header="进度条">
                <MenuItem x:Name="ForwardStepMenu" Header="前进">
                  <MenuItem Header="1.0 秒" Tag="1.0" IsCheckable="True" Click="ProgressStepClicked"/>
                  <MenuItem Header="2.0 秒" Tag="2.0" IsCheckable="True" Click="ProgressStepClicked"/>
                  <MenuItem Header="3.0 秒" Tag="3.0" IsCheckable="True" Click="ProgressStepClicked"/>
                </MenuItem>
                <MenuItem x:Name="BackwardStepMenu" Header="后退">
                  <MenuItem Header="2.0 秒" Tag="2.0" IsCheckable="True" Click="ProgressStepClicked"/>
                  <MenuItem Header="3.0 秒" Tag="3.0" IsCheckable="True" Click="ProgressStepClicked"/>
                  <MenuItem Header="5.0 秒" Tag="5.0" IsCheckable="True" Click="ProgressStepClicked"/>
                </MenuItem>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <TextBlock Text="{Binding CurrentUser}" VerticalAlignment="Center"/>
      </DockPanel>
      <TreeView x:Name="LibraryTree" FontSize="11pt" ItemsSource="{Binding Books}" BorderThickness="0" Background="White"
                SelectedItemChanged="TreeSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Resources>
          <HierarchicalDataTemplate DataType="{x:Type models:NavigationNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,5"/>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"/>
                    <Border x:Name="HeaderArea" Grid.Column="1" Background="Transparent"><ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
                    <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Children" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderArea" Property="Background" Value="#E3E3D6"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
    <Grid Grid.Column="2" Background="Transparent">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="PassageScroll" Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,26,18">
        <StackPanel>
          <TextBlock x:Name="EmptyMessage" Text="选择图书馆，然后在左侧打开文章。" TextWrapping="Wrap" Foreground="#666666" Margin="5,30"/>
          <TextBlock x:Name="ArticleTitleText" Text="{Binding ArticleTitle}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12pt" FontWeight="Bold" Margin="8,4,8,28"/>
          <StackPanel x:Name="ParagraphHost"/>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="PassageToolbar" Grid.Row="1" Height="48" Margin="0,8,0,0" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid x:Name="PassageControls">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Slider x:Name="PlaybackProgress" Visibility="Collapsed" Minimum="0" Maximum="1" SmallChange="0.5" FocusVisualStyle="{x:Null}" IsEnabled="False" Margin="8,0,10,0" VerticalAlignment="Center" IsMoveToPointEnabled="True" ToolTip="拖动调整当前音频的播放位置" ValueChanged="ProgressChanged" Thumb.DragStarted="ProgressDragStarted" Thumb.DragCompleted="ProgressDragCompleted"/>
          <TextBlock Grid.Column="1" x:Name="PlaybackTime" Text="00:00/00:00" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding Visibility, ElementName=PlaybackProgress}" ToolTip="当前播放时长/总时长"/>
          <Button Grid.Column="2" x:Name="ReadAllButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="1" ToolTip="播放文章音频" AutomationProperties.Name="播放文章音频" Click="ArticleAudioClicked"><Image x:Name="ReadAllImage" Source="{x:Static icons:UiIcons.Play}" Width="26" Height="26"/></Button>
          <Button Grid.Column="3" x:Name="StopButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="1" ToolTip="停止正文音频" AutomationProperties.Name="停止正文音频" Click="StopClicked"><Image x:Name="StopImage" Source="{x:Static icons:UiIcons.Stop}" Width="26" Height="26"/></Button>
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
    <DockPanel Grid.Column="4" Margin="7,0,0,0" PreviewMouseDown="IgnoreVocabularyRightClick" PreviewMouseUp="IgnoreVocabularyRightClick">
      <StackPanel DockPanel.Dock="Bottom" Height="48" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <StackPanel x:Name="VocabularyActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <Button x:Name="MoveUpButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="2" ToolTip="上移" AutomationProperties.Name="上移" Click="MoveUpClicked"><Image Source="{x:Static icons:UiIcons.MoveUp}" Width="24" Height="24"/></Button>
          <Button x:Name="MoveDownButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="2" ToolTip="下移" AutomationProperties.Name="下移" Click="MoveDownClicked"><Image Source="{x:Static icons:UiIcons.MoveDown}" Width="24" Height="24"/></Button>
          <Button x:Name="DeleteWordButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="2" ToolTip="删除" AutomationProperties.Name="删除" Click="DeleteWordClicked"><Image Source="{x:Static icons:UiIcons.Delete}" Width="24" Height="24"/></Button>
        </StackPanel>
        <Button x:Name="HighlightButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="2" ToolTip="显示正文词汇高亮" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}" Click="HighlightClicked"><Image x:Name="HighlightImage" Source="{x:Static icons:UiIcons.HighlightOn}" Width="24" Height="24"/></Button>
        <Button x:Name="ImportButton" Style="{StaticResource FooterButton}" Width="32" Height="32" Padding="1" ToolTip="导入词汇表" AutomationProperties.Name="导入词汇表" Click="ImportClicked"><Image Source="{x:Static icons:UiIcons.Import}" Width="26" Height="26"/></Button>
      </StackPanel>
      <ListBox x:Name="VocabularyList" FontSize="11pt" ItemsSource="{Binding Words}" AlternationCount="2" BorderThickness="0" Padding="0"
               Background="White" HorizontalContentAlignment="Stretch" SelectionChanged="VocabularySelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="White"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="Row" Property="Background" Value="#F5F7F3"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF3F8"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="10,10,10,9">
              <TextBlock Text="{Binding Word}" Foreground="#2C78B9" FontWeight="Bold" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,5,0,4">
                <TextBlock Text="{Binding PhoneticUk}" VerticalAlignment="Center" ToolTip="British / UK"/>
                <Button Content="🔊" Command="{Binding PlayUk}" IsEnabled="{Binding CanPlayUk}" ToolTip="播放 UK" Padding="3,0" Background="Transparent" BorderThickness="0"/>
                <TextBlock Text="{Binding PhoneticUs}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="American / US"/>
                <Button Content="🔊" Command="{Binding PlayUs}" IsEnabled="{Binding CanPlayUs}" ToolTip="播放 US" Padding="3,0" Background="Transparent" BorderThickness="0"/>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding Meanings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="{Binding Pos}" FontWeight="Bold"/><Run Text=" "/><Run Text="{Binding Text}"/></TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" Foreground="#666666"
               Margin="1,8,1,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</Window>
